<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>WC — Called from Slack (Workflow Builder + Salesforce connector) with Claim Id and Approve/Reject. Updates Claim approval fields.</description>
    <interviewLabel>WC Update Claim From Slack Decision {!$Flow.CurrentDateTime}</interviewLabel>
    <label>WC Update Claim From Slack Decision</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Route_Decision</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <decisions>
        <name>Route_Decision</name>
        <label>Route Decision</label>
        <locationX>182</locationX>
        <locationY>158</locationY>
        <defaultConnectorLabel>Unrecognized</defaultConnectorLabel>
        <rules>
            <name>Approve_Path</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inputDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approve</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Claim_Approved</targetReference>
            </connector>
            <label>Approve</label>
        </rules>
        <rules>
            <name>Reject_Path</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inputDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reject</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Claim_Rejected</targetReference>
            </connector>
            <label>Reject</label>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Update_Claim_Approved</name>
        <label>Update Claim Approved</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputClaimId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>WC_Approval_Result__c</field>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WC_Approval_Channel__c</field>
            <value>
                <stringValue>Slack</stringValue>
            </value>
        </inputAssignments>
        <object>Claim</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Claim_Rejected</name>
        <label>Update Claim Rejected</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputClaimId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>WC_Approval_Result__c</field>
            <value>
                <stringValue>Rejected</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WC_Approval_Channel__c</field>
            <value>
                <stringValue>Slack</stringValue>
            </value>
        </inputAssignments>
        <object>Claim</object>
    </recordUpdates>
    <variables>
        <name>inputClaimId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inputDecision</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
