<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Voice Call Transcript</masterLabel>
    <description>Rich transcript and recordings for VoiceCall (ConversationEntry + VoiceCallRecording).</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>VoiceCall</object>
                <object>Conversation</object>
            </objects>
        </targetConfig>
        <targetConfig targets="lightning__AppPage">
            <property
                name="conversationId"
                label="VoiceCall or Conversation Id"
                type="String"
                description="Use when not on a VoiceCall / Conversation record page."
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>